<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-targeted: Wolfram.NETLink's native ml64i4.dll and
         EvaluateToImage (System.Drawing.Image) are desktop/Windows. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Lets this restore/compile on a non-Windows build agent (won't run there). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official Wolfram .NET/Link. Managed-only: at runtime it P/Invokes the
         native ml64i4.dll from the Mathematica install (MathematicaLocator puts
         that dir on PATH). Version matched to the proven connect test.
         NU1701: package targets .NET Framework but Wolfram supports it on modern .NET. -->
    <PackageReference Include="Wolfram.NETLink" Version="1.7.1" NoWarn="NU1701" />

    <!-- Needed by EvaluateToImage. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native MathLink library kept in the PROJECT ROOT (next to this .csproj),
         not in bin/, so `dotnet clean` cannot delete it. The build copies it into
         the output dir on every build, so P/Invoke and MathematicaLocator's
         exe-directory check find it (and pin THIS copy over PATH discovery).
         The file itself is git-ignored — it's a licensed, machine/version-specific
         binary, so each machine keeps its own. If you dropped it at the REPO root
         instead, change the Include path to ..\..\ml64i4.dll and add
         <Link>ml64i4.dll</Link> so it still lands flat in the output. -->
    <None Include="ml64i4.dll" Condition="Exists('ml64i4.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Alternative to the NuGet package: reference the Wolfram.NETLink.dll that
    ships INSIDE your Mathematica install (a matched managed/native pair — use
    this if you hit a version mismatch). Remove the PackageReference above and:
    <ItemGroup>
      <Reference Include="Wolfram.NETLink">
        <HintPath>C:\Program Files\Wolfram Research\Mathematica\15.0\SystemFiles\Links\NETLink\Wolfram.NETLink.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  -->

</Project>
